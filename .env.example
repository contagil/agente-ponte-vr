# ============================================================
# Reforma Legal — onde entregar os pedidos
# ============================================================
# Em produção, a URL pública do backend do RL. Em desenvolvimento, aponte pro
# backend local (precisa estar rodando e com a MESMA AGENTE_VR_PONTE_API_KEY
# no .env dele).
RL_BASE_URL=http://localhost:8000/api

# Segredo compartilhado só com o RL — não é a AGENTE_VR_API_KEY abaixo. Gere
# uma string aleatória longa (ex.: `openssl rand -hex 32` ou
# `python -c "import secrets; print(secrets.token_hex(32))"`) e cole a MESMA
# no .env do backend do RL (variável AGENTE_VR_PONTE_API_KEY lá).
PONTE_API_KEY=

# ============================================================
# Cérebro do agent-vr (rede interna da Contágil)
# ============================================================
# Só alcançável de dentro da rede — não é a URL pública dos agentes
# (agents.contagilpb.com.br publica só as rotas deles). Ver
# docs/ACESSO-API-APP-EXTERNA.md no repo do agent-vr.
AGENTE_VR_API_URL=http://10.0.100.204:8040/api/v1
AGENTE_VR_API_KEY=
# precisa ser maior que o timeout_ms da tarefa mais lenta + 15s de margem
AGENTE_VR_TIMEOUT_S=180

# Chave SEPARADA da AGENTE_VR_API_KEY acima — só pra provisionar cliente/
# agente (PROPOSTA-PROVISIONAMENTO.md). Criada no console do agent-vr numa
# api_app com as permissões clients.edit/agents.create/agents.package
# concedidas explicitamente (ver docs/PROPOSTA-PROVISIONAMENTO.md §3.1).
# Vazio = sincronização continua funcionando normalmente, só o
# provisionamento pelo RL fica indisponível.
AGENTE_VR_PROVISIONAMENTO_API_KEY=

# task_id das consultas no catálogo do agent-vr (só mexer se cadastrarem com
# outro nome no console) — ver docs/agente-vr-catalogo-tarefas.md. As sete
# primeiras (NCM/CST/CClassTrib) são obrigatórias; sem as demais, a análise
# correspondente fica de fora do relatório em vez de derrubar a sincronização.
AGENTE_VR_TASK_NCM_CADASTRADO=reforma_ncm_cadastrado
AGENTE_VR_TASK_NCM_PRODUTOS=reforma_ncm_produtos
AGENTE_VR_TASK_NCM_ATIVOS=reforma_ncm_ativos
AGENTE_VR_TASK_CST=reforma_cst_cadastrado
AGENTE_VR_TASK_CCLASSTRIB=reforma_cclasstrib_cadastrada
AGENTE_VR_TASK_CCLASSTRIB_NCM=reforma_cclasstrib_vinculo_ncm
AGENTE_VR_TASK_CCLASSTRIB_PRODUTO=reforma_cclasstrib_vinculo_produto
AGENTE_VR_TASK_ESTADOS=reforma_estados
AGENTE_VR_TASK_IBS_ESTADUAL=reforma_ibs_estadual
AGENTE_VR_TASK_IBS_MUNICIPAL=reforma_ibs_municipal
AGENTE_VR_TASK_MUNICIPIOS=reforma_municipios
AGENTE_VR_TASK_CBS=reforma_cbs
AGENTE_VR_TASK_VINCULO_PRODUTOS=reforma_vinculo_produtos
AGENTE_VR_TASK_VINCULO_PRODUTO=reforma_vinculo_produto
AGENTE_VR_TASK_VINCULO_NCM=reforma_vinculo_ncm
AGENTE_VR_TASK_CLASSIFICACOES=reforma_classificacoes
AGENTE_VR_TASK_TIPODEBITOCREDITO=reforma_tipodebitocredito
AGENTE_VR_TASK_DEBITOCREDITO=reforma_debitocredito
AGENTE_VR_TASK_TIPOSAIDA=reforma_tiposaida
AGENTE_VR_TASK_CFOPTIPOSAIDA=reforma_cfoptiposaida
AGENTE_VR_TASK_MOVIMENTO_TIPOSAIDA=reforma_movimento_tiposaida
AGENTE_VR_TASK_OPERACOES_SEM_TIPOSAIDA=reforma_operacoes_sem_tiposaida
AGENTE_VR_TASK_PARAMETRO_NFE=reforma_parametro_nfe
AGENTE_VR_TASK_PARAMETRO_PDV=reforma_parametro_pdv
AGENTE_VR_TASK_TIPOAUTOR=reforma_tipoautor
AGENTE_VR_TASK_TIPOEVENTO=reforma_tipoevento
AGENTE_VR_TASK_EVENTOS_TOTAIS=reforma_eventos_totais
AGENTE_VR_TASK_EMPRESAS=reforma_empresas

# ============================================================
# Base oficial de referência (Calculadora Offline da RFB)
# ============================================================
# ~260MB no pacote original, mas só o codigo-fonte-backend.zip (poucos MB) é
# usado — a pasta abaixo precisa conter esse arquivo.
RFB_CALCULADORA_DIR=./data/calculadora_rfb
RFB_CACHE_SQLITE=./data/rfb_reference_cache.sqlite
NCM_VIGENTE_JSON=./data/Tabela_NCM_Vigente_20260723.json

# ============================================================
# Comportamento da ponte
# ============================================================
LOG_LEVEL=INFO
# heartbeat rico (escopo/base RFB) — o long-poll em si já prova que a ponte
# está viva; isto só atualiza o diagnóstico
HEARTBEAT_INTERVAL_S=60
# espera após falha de rede (RL ou cérebro fora do ar) antes de tentar de novo
RETRY_BACKOFF_S=5
